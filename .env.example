# GitHub OAuth application (profile-only; users grant no repository access)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Separate PRIVATE runtime-data repository. Fine-grained token: Contents read/write
# ONLY for this data repository. Never prefix any secret with NEXT_PUBLIC_.
GITHUB_DATA_OWNER=
GITHUB_DATA_REPO=
GITHUB_DATA_BRANCH=main
GITHUB_DATA_TOKEN=

# Optional closed pilot: comma-separated numeric GitHub user IDs.
APP_ALLOWED_GITHUB_IDS=
